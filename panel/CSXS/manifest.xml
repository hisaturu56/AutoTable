<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.hisaturu.autotable" ExtensionBundleVersion="1.9.2"
                   ExtensionBundleName="AutoTable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.hisaturu.autotable.panel" Version="1.9.2"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Illustrator CC 2018（22.0）以降 -->
      <Host Name="ILST" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.hisaturu.autotable.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- Node を使えるようにする（Notion との通信・トークンのしまい方に使う。画面からの通信は Notion に断られるため） -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>テーブル自動作成</Menu>
          <Geometry>
            <Size>
              <Height>820</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>200</Height>
              <Width>240</Width>
            </MinSize>
            <!-- 最大の大きさを決めておくと、パネルを伸ばしたときに中身も一緒に広がる -->
            <MaxSize>
              <Height>4000</Height>
              <Width>2000</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
